---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Services - Ginete Healthcare Consulting Group"
  description="Comprehensive healthcare compliance services including HIPAA, Joint Commission, CMS regulations, training, and risk assessment from Ginete Healthcare Consulting Group."
  keywords="HIPAA services, Joint Commission accreditation, CMS compliance, healthcare training, risk assessment"
  activePage="services"
>
    <section class="hero" style="padding: 4rem 0 3rem 0;">
        <div class="container">
            <div class="hero-content">
                <h1 class="hero-title">Our Services</h1>
                <p class="hero-subtitle">Comprehensive healthcare compliance solutions tailored to your organization's
                    needs</p>
            </div>
        </div>
        <div class="hero-wave"></div>
    </section>

    <section class="section" id="cms">
        <div class="container">
            <div class="service-detail">
                <h2>CMS Compliance Services</h2>
                <p class="service-intro">Navigate the complex landscape of Centers for Medicare & Medicaid Services
                    regulations with expert guidance and comprehensive support for Medicare Advantage, Part D, and
                    Medicaid programs.</p>

                <div class="service-features">
                    <div class="service-feature-item">
                        <h3>Conditions of Participation (CoPs)</h3>
                        <p>Ensure your organization meets all CMS Conditions of Participation requirements for Medicare
                            and Medicaid certification and reimbursement.</p>
                    </div>
                    <div class="service-feature-item">
                        <h3>Medicare Advantage & Part D</h3>
                        <p>Comprehensive compliance support for MA and Part D plans including enrollment, marketing,
                            member communications, and Stars ratings improvement.</p>
                    </div>
                    <div class="service-feature-item">
                        <h3>Quality Reporting Programs</h3>
                        <p>Navigate MIPS, Hospital Quality Reporting, and other CMS quality measurement programs with
                            confidence and accuracy.</p>
                    </div>
                    <div class="service-feature-item">
                        <h3>Audit Response & Remediation</h3>
                        <p>Expert support for CMS audits, program audits, and corrective action plan development and
                            implementation.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section" style="background-color: var(--bg-light);" id="dhcs-dmhc">
        <div class="container">
            <div class="service-detail">
                <h2>DHCS & DMHC Compliance</h2>
                <p class="service-intro">California-specific healthcare compliance expertise for Medi-Cal managed care
                    plans and health plans regulated by the Department of Managed Health Care.</p>

                <div class="service-features">
                    <div class="service-feature-item">
                        <h3>Medi-Cal Managed Care Plans</h3>
                        <p>Full-service compliance support for Medi-Cal managed care plans including contract
                            requirements, network adequacy, and quality improvement.</p>
                    </div>
                    <div class="service-feature-item">
                        <h3>DMHC Licensing & Surveys</h3>
                        <p>Prepare for and respond to DMHC routine and targeted surveys, including full-service and
                            specialized health plan requirements.</p>
                    </div>
                    <div class="service-feature-item">
                        <h3>Plan Enrollment & Operations</h3>
                        <p>Ensure compliance with enrollment procedures, member communications, provider network
                            management, and operational standards.</p>
                    </div>
                    <div class="service-feature-item">
                        <h3>Grievance & Appeals Systems</h3>
                        <p>Develop and maintain compliant grievance and appeals processes that meet both DHCS and DMHC
                            requirements.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="ncqa">
        <div class="container">
            <div class="service-detail">
                <h2>NCQA Accreditation Services</h2>
                <p class="service-intro">Achieve and maintain National Committee for Quality Assurance (NCQA)
                    accreditation for health plans, medical groups, and patient-centered medical homes.</p>

                <div class="service-features">
                    <div class="service-feature-item">
                        <h3>Health Plan Accreditation</h3>
                        <p>Comprehensive support for NCQA Health Plan Accreditation including commercial, Medicaid,
                            Medicare, and multi-product accreditation pathways.</p>
                    </div>
                    <div class="service-feature-item">
                        <h3>HEDIS Reporting & Quality</h3>
                        <p>Expert guidance on HEDIS measure reporting, data validation, quality improvement strategies,
                            and Stars rating optimization.</p>
                    </div>
                    <div class="service-feature-item">
                        <h3>PCMH Recognition</h3>
                        <p>Achieve Patient-Centered Medical Home (PCMH) recognition with support for practice
                            transformation and documentation requirements.</p>
                    </div>
                    <div class="service-feature-item">
                        <h3>Standards Implementation</h3>
                        <p>Gap analysis, policy development, and operational readiness to meet NCQA standards across all
                            required elements.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section cta-section">
        <div class="container">
            <div class="cta-content">
                <h2>Let's Build Your Compliance Strategy</h2>
                <p>Schedule a consultation to discuss how our services can support your organization's compliance goals.
                </p>
                <div class="cta-buttons">
                    <a href="/contact" class="btn btn-primary">Contact Us Today</a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
