---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Us - Ginete Healthcare Consulting Group"
  description="Learn about Ginete Healthcare Consulting Group, our mission, values, and team of healthcare compliance experts."
  keywords="healthcare consulting firm, compliance experts, healthcare team, about ginete"
  activePage="about"
>
    <section class="hero" style="padding: 4rem 0 3rem 0;">
        <div class="container">
            <div class="hero-content">
                <h1 class="hero-title">About Ginete</h1>
                <p class="hero-subtitle">Empowering healthcare organizations to achieve excellence through compliance
                </p>
            </div>
        </div>
        <div class="hero-wave"></div>
    </section>

    <section class="section">
        <div class="container">
            <div class="section-header center">
                <h2>Our Mission</h2>
            </div>
            <div style="max-width: 900px; margin: 0 auto;">
                <p style="font-size: 1.125rem; line-height: 1.8; text-align: center; color: var(--text-medium);">
                    At Ginete Healthcare Consulting Group, our mission is to provide healthcare organizations with
                    comprehensive and effective solutions that ensure regulatory compliance, mitigate risk, and promote
                    ethical practices. We are committed to staying current with the latest industry regulations and
                    standards, delivering customized services that meet each client's unique needs and challenges.
                </p>
                <p
                    style="font-size: 1.125rem; line-height: 1.8; text-align: center; color: var(--text-medium); margin-top: var(--spacing-md);">
                    Through our expertise, dedication, and collaboration with our clients, we empower healthcare
                    organizations to deliver safe, effective, and high-quality care while maintaining compliance and
                    integrity.
                </p>
            </div>
        </div>
    </section>

    <section class="section" style="background-color: var(--bg-light);">
        <div class="container">
            <div class="section-header center">
                <h2>Our Values</h2>
                <p>The principles that guide everything we do</p>
            </div>

            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2">
                            <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                            <path d="M2 17l10 5 10-5"></path>
                            <path d="M2 12l10 5 10-5"></path>
                        </svg>
                    </div>
                    <h3>Excellence</h3>
                    <p>We deliver the highest quality consulting services and maintain the highest professional
                        standards in everything we do.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        </svg>
                    </div>
                    <h3>Integrity</h3>
                    <p>We maintain transparency and accountability in all our client relationships and business
                        practices.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <h3>Collaboration</h3>
                    <p>We work closely with our clients to understand their unique challenges and develop solutions
                        together.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                    <h3>Innovation</h3>
                    <p>We leverage innovative strategies and technologies to help clients navigate the evolving
                        regulatory landscape.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="team">
        <div class="container">
            <div class="section-header center">
                <h2>Our Team</h2>
                <p>Experienced healthcare compliance professionals dedicated to your success</p>
            </div>

            <div class="team-grid">
                <div class="team-member">
                    <div class="team-photo">
                        <img src="/images/jenny-terry.jpg" alt="Jenny Terry"
                            style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;">
                    </div>
                    <h3>Jenny Terry</h3>
                    <p class="team-title">Founder & Lead Consultant</p>
                    <p class="team-bio">Jenny brings over 15 years of healthcare compliance expertise, specializing in
                        HIPAA, Joint Commission standards, and CMS regulations. Her comprehensive approach helps
                        organizations build sustainable compliance programs that protect patients and support
                        operational excellence.</p>
                    <div class="team-credentials">
                        <span class="credential">CHC</span>
                        <span class="credential">CHRC</span>
                        <span class="credential">CPHRM</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section cta-section">
        <div class="container">
            <div class="cta-content">
                <h2>Partner With Us</h2>
                <p>Let's work together to strengthen your compliance program and achieve your organizational goals.</p>
                <div class="cta-buttons">
                    <a href="/contact" class="btn btn-primary">Get in Touch</a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
