---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Ginete Healthcare Consulting Group - Healthcare Compliance Experts"
  description="Ginete Healthcare Consulting Group provides comprehensive healthcare compliance solutions including HIPAA, Joint Commission accreditation, CMS regulations, and compliance training."
  keywords="healthcare compliance, HIPAA compliance, Joint Commission, CMS regulations, healthcare consulting, compliance training"
  activePage="home"
>
    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-content">
                <h1 class="hero-title">
                    <span class="hero-greeting">Ti Ginete?</span>
                    How's Your Healthcare Compliance Going?
                </h1>
                <p class="hero-subtitle">
                    We know healthcare regulations are complicated. Ginete Healthcare Consulting Group helps you
                    navigate local, state, and federal compliance requirements with confidence and ease.
                </p>
                <div class="hero-cta">
                    <a href="/contact" class="btn btn-primary">Get Started</a>
                    <a href="/services" class="btn btn-secondary">Our Services</a>
                </div>
            </div>
        </div>
        <div class="hero-wave"></div>
    </section>

    <!-- Value Proposition -->
    <section class="section value-prop">
        <div class="container">
            <div class="section-header center">
                <h2>Becoming Leaders in Healthcare Compliance</h2>
                <p>Ginete (&gamma;&iota;&nu;&epsilon;&tau;&epsilon;) means "becoming" in Greek. We support your journey to becoming a leader in your
                    market by ensuring you maintain regulatory compliance at all times.</p>
            </div>

            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </div>
                    <h3>Comprehensive Solutions</h3>
                    <p>Customized compliance strategies tailored to your organization's unique needs and challenges.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <h3>Expert Team</h3>
                    <p>Experienced healthcare compliance professionals dedicated to your success.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="3" y1="9" x2="21" y2="9"></line>
                            <line x1="9" y1="21" x2="9" y2="9"></line>
                        </svg>
                    </div>
                    <h3>Risk Mitigation</h3>
                    <p>Identify and manage compliance risks before they become problems.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                            <path d="M2 17l10 5 10-5"></path>
                            <path d="M2 12l10 5 10-5"></path>
                        </svg>
                    </div>
                    <h3>Training & Education</h3>
                    <p>Comprehensive training programs to build a culture of compliance.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Overview -->
    <section class="section services-overview">
        <div class="container">
            <div class="section-header center">
                <h2>Our Core Services</h2>
                <p>Comprehensive compliance solutions for healthcare organizations of all sizes</p>
            </div>

            <div class="services-grid">
                <div class="service-card">
                    <h3>CMS Compliance</h3>
                    <p>Navigate Medicare and Medicaid regulations with comprehensive support and expertise.</p>
                    <ul class="service-list">
                        <li>Conditions of Participation</li>
                        <li>Quality Reporting Programs</li>
                        <li>Medicare Advantage Compliance</li>
                        <li>Audit Response & Remediation</li>
                    </ul>
                    <a href="/services#cms" class="service-link">Learn More &rarr;</a>
                </div>

                <div class="service-card">
                    <h3>DHCS & DMHC</h3>
                    <p>California-specific healthcare compliance for Medi-Cal and managed care organizations.</p>
                    <ul class="service-list">
                        <li>Medi-Cal Managed Care Plans</li>
                        <li>DMHC Licensing & Surveys</li>
                        <li>Plan Enrollment & Operations</li>
                        <li>Grievance & Appeals Systems</li>
                    </ul>
                    <a href="/services#dhcs-dmhc" class="service-link">Learn More &rarr;</a>
                </div>

                <div class="service-card">
                    <h3>NCQA Accreditation</h3>
                    <p>Achieve and maintain NCQA accreditation for health plans and medical groups.</p>
                    <ul class="service-list">
                        <li>Health Plan Accreditation</li>
                        <li>HEDIS Reporting & Quality</li>
                        <li>PCMH Recognition</li>
                        <li>Standards Implementation</li>
                    </ul>
                    <a href="/services#ncqa" class="service-link">Learn More &rarr;</a>
                </div>
            </div>

            <div class="center" style="margin-top: 3rem;">
                <a href="/services" class="btn btn-primary">View All Services</a>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="section cta-section">
        <div class="container">
            <div class="cta-content">
                <h2>Ready to Strengthen Your Compliance Program?</h2>
                <p>Let's discuss how we can help your organization achieve and maintain regulatory compliance.</p>
                <div class="cta-buttons">
                    <a href="/contact" class="btn btn-primary">Schedule a Consultation</a>
                    <a href="/resources" class="btn btn-secondary-white">Download Free Resources</a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
