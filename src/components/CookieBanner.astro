<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Cookie consent" hidden>
    <div class="cookie-banner-content">
        <div class="cookie-banner-text">
            <p>We use cookies and similar technologies to ensure the basic functionality of this website. You can choose which categories to allow. For more details, see our <a href="/privacy#cookies">Privacy Policy</a>.</p>
        </div>
        <div class="cookie-banner-actions">
            <button type="button" class="btn btn-primary cookie-btn" id="cookie-accept-all">Accept All</button>
            <button type="button" class="btn btn-secondary cookie-btn" id="cookie-essential-only">Essential Only</button>
            <button type="button" class="cookie-settings-toggle" id="cookie-settings-toggle">Cookie Settings</button>
        </div>
    </div>

    <div class="cookie-settings-panel" id="cookie-settings-panel" hidden>
        <div class="cookie-category">
            <div class="cookie-category-header">
                <div>
                    <strong>Essential</strong>
                    <p>Required for the website to function. Cannot be disabled.</p>
                </div>
                <span class="cookie-always-on">Always on</span>
            </div>
        </div>
        <div class="cookie-category">
            <div class="cookie-category-header">
                <div>
                    <strong>Functional</strong>
                    <p>Remember your preferences like cookie consent choices and form data.</p>
                </div>
                <label class="cookie-toggle">
                    <input type="checkbox" id="cookie-functional" checked>
                    <span class="cookie-toggle-slider"></span>
                </label>
            </div>
        </div>
        <div class="cookie-settings-actions">
            <button type="button" class="btn btn-primary cookie-btn" id="cookie-save-settings">Save Settings</button>
        </div>
    </div>
</div>
